# ===== Unreal Engine 5 / C++ .gitignore =====

# IDE and editor files
.vs/
.vscode/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
*.code-workspace
*.sublime-project
*.sublime-workspace
*.DotSettings.user
.vsconfig

# Build output and generated folders
[Bb]inaries/
[Bb]uild/
[Oo]bj/
[Ll]ib/
[Ll]ibs/
Intermediate/
DerivedDataCache/
Saved/

# Note: Build/ sometimes holds platform config files
# (e.g. Build/Android, Build/IOS). To track them, uncomment:
# !Build/
# Build/*
# !Build/*/
# !Build/*/PakBlacklist*.txt
# !Build/*/**

# Compiler and linker artifacts
*.ipch
*.pdb
*.ilk
*.exp
*.obj
*.o
*.a
*.lib
*.dll
*.exe
*.so
*.dylib
*.dSYM/

# Logs, caches and temp files
*.log
*.tmp
*.temp
*.cache
*.bak

# Plugin build output
/Plugins/**/Binaries/
/Plugins/**/Intermediate/
*.uproject.user

# Packaging / cook output
/Packaged/
/Package/
/Builds/
/Staged/
/StagedBuilds/

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Crash dumps and profiling output
*.dmp
*.stackdump
Saved/Crashes/
Saved/Logs/
Saved/Autosaves/

# Python (if used)
__pycache__/
*.pyc